pipeline {
    agent any

    environment {
        REGISTRY = 'enterprisebankacr.azurecr.io'
        IMAGE_TAG = "build-${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Images') {
            parallel {

                stage('Frontend') {
                    steps {
                        sh '''
                            docker build \
                              -t ${REGISTRY}/frontend:${IMAGE_TAG} \
                              application/frontend
                        '''
                    }
                }

                stage('Account Service') {
                    steps {
                        sh '''
                            docker build \
                              -t ${REGISTRY}/account-service:${IMAGE_TAG} \
                              application/account-service
                        '''
                    }
                }

                stage('Payment Service') {
                    steps {
                        sh '''
                            docker build \
                              -t ${REGISTRY}/payment-service:${IMAGE_TAG} \
                              application/payment-service
                        '''
                    }
                }

                stage('Transaction Service') {
                    steps {
                        sh '''
                            docker build \
                              -t ${REGISTRY}/transaction-service:${IMAGE_TAG} \
                              application/transaction-service
                        '''
                    }
                }
            }
        }

        stage('Login to ACR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'azure-sp',
                        usernameVariable: 'ACR_USERNAME',
                        passwordVariable: 'ACR_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "$ACR_PASSWORD" | docker login \
                          "$REGISTRY" \
                          --username "$ACR_USERNAME" \
                          --password-stdin
                    '''
                }
            }
        }

        stage('Push Images') {
            steps {
                sh '''
                    docker push ${REGISTRY}/frontend:${IMAGE_TAG}
                    docker push ${REGISTRY}/account-service:${IMAGE_TAG}
                    docker push ${REGISTRY}/payment-service:${IMAGE_TAG}
                    docker push ${REGISTRY}/transaction-service:${IMAGE_TAG}
                '''
            }
        }

        stage('Deploy to AKS') {
            steps {
                sh '''
                    kubectl -n banking set image deployment/frontend \
                      frontend=${REGISTRY}/frontend:${IMAGE_TAG}

                    kubectl -n banking set image deployment/account-service \
                      account-service=${REGISTRY}/account-service:${IMAGE_TAG}

                    kubectl -n banking set image deployment/payment-service \
                      payment-service=${REGISTRY}/payment-service:${IMAGE_TAG}

                    kubectl -n banking set image deployment/transaction-service \
                      transaction-service=${REGISTRY}/transaction-service:${IMAGE_TAG}
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    kubectl rollout status deployment/frontend -n banking
                    kubectl rollout status deployment/account-service -n banking
                    kubectl rollout status deployment/payment-service -n banking
                    kubectl rollout status deployment/transaction-service -n banking
                '''
            }
        }

        stage('Show Pods') {
            steps {
                sh '''
                    kubectl get pods -n banking -o wide
                '''
            }
        }
    }
}